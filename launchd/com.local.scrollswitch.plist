<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
	"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.local.scrollswitch</string>

	<key>ProgramArguments</key>
	<array>
		<string>@BINDIR@/scrollswitch</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/tmp/scrollswitch.out.log</string>

	<key>StandardErrorPath</key>
	<string>/tmp/scrollswitch.err.log</string>
</dict>
</plist>

